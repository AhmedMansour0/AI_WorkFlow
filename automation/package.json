{
  "name": "orangehrm-auth-admin-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright (TypeScript) POM suite for OrangeHRM Authentication and Admin > User Management",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=auth-ui --project=admin-ui",
    "test:api": "playwright test --project=api",
    "test:auth": "playwright test --grep @auth",
    "test:adm": "playwright test --grep @adm",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
